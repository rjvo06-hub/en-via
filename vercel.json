{
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "driver.en-via.werksolutions.de"
        }
      ],
      "dest": "/conductor/index.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "user.en-via.werksolutions.de"
        }
      ],
      "dest": "/usuario/index.html"
    }
  ]
}
